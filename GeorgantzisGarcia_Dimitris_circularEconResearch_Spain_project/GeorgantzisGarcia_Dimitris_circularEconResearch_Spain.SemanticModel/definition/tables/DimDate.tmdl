	partition DimDate = calculated
		mode: import
		source =
				
				ADDCOLUMNS (
				    CALENDAR (
				        DATE ( YEAR ( MIN ( FactPapers[PublicationDate] ) ), 1, 1 ),
				        DATE ( YEAR ( MAX ( FactPapers[PublicationDate] ) ), 12, 31 )
				    ),
				    "Year", YEAR ( [Date] ),
				    "Quarter", "Q" & QUARTER ( [Date] ),
				    "Month Number", MONTH ( [Date] ),
				    "Month", FORMAT ( [Date], "mmm", "en-US" ),
				    "Year Month", FORMAT ( [Date], "yyyy-mm" ),
				    "Weekday Number", WEEKDAY ( [Date], 2 ),
				    "Weekday", FORMAT ( [Date], "ddd", "en-US" )
				)

	annotation PBI_Id = 25c8e79c5a9047ba9f002d2bb5432c21

