		sourceColumn: Longitude

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	/// Region from OpenAlex where present; otherwise derived from the city, mapped by testing institution coordinates against Natural Earth regional boundaries (197 of 197 known regions reproduced).
	column 'Region Complete' =
			
			IF (
			    LEN ( DimInstitution[Region] ) > 0,
			    DimInstitution[Region],
			    SWITCH (
			        DimInstitution[City],
			        "Alcalá de Henares", "Madrid",
			        "Alcobendas", "Madrid",
			        "Alcoy", "Valencia",
			        "Arganda", "Madrid",
			        "Avilés", "Asturias",
			        "Badajoz", "Extremadura",
