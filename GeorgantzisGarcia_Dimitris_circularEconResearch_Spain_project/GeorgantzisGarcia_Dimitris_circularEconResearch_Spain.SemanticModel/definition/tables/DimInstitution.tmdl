			        "Beasain", "Basque Country",
			        "Bilbao", "Basque Country",
			        "Blanes", "Catalonia",
			        "Boecillo", "Castille and León",
			        "Carreña", "Asturias",
			        "Cartagena", "Murcia",
			        "Castellon", "Valencia",
			        "Castelló de la Plana", "Valencia",
			        "Cerdanyola del Vallès", "Catalonia",
			        "Ciudad Real", "Castille-La Mancha",
