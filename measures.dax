// =====================================================================
// DAX: calendar table, calculated columns and measures
// Generated from the .pbip project (SemanticModel/definition/tables/*.tmdl).
// The project is the source of truth; regenerate this file rather than editing it.
// =====================================================================

// ---------------------------------------------------------------------
// CALCULATED TABLE  DimDate  (Modeling > New table)
// Then: sort Month by Month Number and Weekday by Weekday Number,
// and Table tools > Mark as date table (Date column).
// ---------------------------------------------------------------------
DimDate =
    ADDCOLUMNS (
        CALENDAR (
            DATE ( YEAR ( MIN ( FactPapers[PublicationDate] ) ), 1, 1 ),
            DATE ( YEAR ( MAX ( FactPapers[PublicationDate] ) ), 12, 31 )
        ),
        "Year", YEAR ( [Date] ),
        "Quarter", "Q" & QUARTER ( [Date] ),
        "Month Number", MONTH ( [Date] ),
        "Month", FORMAT ( [Date], "mmm", "en-US" ),
        "Year Month", FORMAT ( [Date], "yyyy-mm" ),
        "Weekday Number", WEEKDAY ( [Date], 2 ),
        "Weekday", FORMAT ( [Date], "ddd", "en-US" )
    )


// ---------------------------------------------------------------------
// CALCULATED TABLE  StoryGroups  (Modeling > New table)
// ---------------------------------------------------------------------
StoryGroups =
    DATATABLE (
        "Group", STRING, "Order", INTEGER, "Papers", INTEGER, "Consumption", INTEGER, "Production", INTEGER,
        {
            { "All Spanish research", 1, 1217389, 40608, 72186 },
            { "CE, not tagged", 2, 0, 0, 0 },
            { "CE, SDG 12 tagged", 3, 0, 0, 0 },
            { "All SDG 12 papers", 4, 35041, 5102, 12775 }
        }
    )


// ---------------------------------------------------------------------
